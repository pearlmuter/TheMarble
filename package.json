{
  "name": "terra-jewel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-basis-transcoder.mjs && vite",
    "build": "node scripts/prepare-basis-transcoder.mjs && tsc && vite build",
    "publish:earth-state": "node scripts/publish-earth-state.mjs",
    "publish:gmgsi": "node scripts/publish-gmgsi-earth-state.mjs",
    "publish:clouds": "node scripts/publish-cloud-earth-state.mjs",
    "publish:cloud-gaps": "node scripts/publish-cloud-gap-earth-state.mjs",
